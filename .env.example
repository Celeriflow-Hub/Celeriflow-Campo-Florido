# ---- App ----
# URL pública (Vercel preenche sozinho no deploy; local use http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Neon Postgres (https://neon.tech) ----
# Pegue em: Neon Console > Connection Details (pooled + non-pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# ---- Vercel Blob (https://vercel.com/docs/storage/vercel-blob) ----
# Gerado com: vercel blob / Storage tab no dashboard
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ---- Firebase Client (NEXT_PUBLIC_* exposto no browser) ----
NEXT_PUBLIC_FIREBASE_API_KEY=xxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xxx.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxx
NEXT_PUBLIC_FIREBASE_APP_ID=xxx

# ---- Firebase Admin (server-only, NUNCA exponha) ----
# Opção A (recomendada na Vercel): JSON do service account em base64
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Opção B: 3 variáveis separadas
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
